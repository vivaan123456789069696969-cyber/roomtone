# Copy to .env.local for local development. Never commit real values.
#
# Leave both Supabase values empty to run in DEMO MODE: accounts, photos and
# projects stay in the browser and concepts are labelled colour studies.

# Browser-safe values from Supabase → Project Settings → API.
# The anon (public) key is designed to be exposed; row-level security protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side only. Set these as Supabase Edge Function secrets, NOT here:
#   supabase secrets set GEMINI_API_KEY=your-key-here
#   supabase secrets set GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
#   supabase secrets set DAILY_GENERATION_LIMIT=12
#   supabase secrets set ALLOWED_ORIGIN=https://your-site.example
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# to edge functions automatically. Never put the service-role key in VITE_ vars.
